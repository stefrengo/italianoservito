---
const links = [
  { href: '/', label: 'Home' },
  { href: '/chi-sono', label: 'Chi Sono' },
  { href: '/approfondimenti', label: 'Approfondimenti' },
  { href: '/contatti', label: 'Contatti' },
];

const percorsiLinks = [
  { href: '/percorsi/sbloccati-da-zero', label: 'Sbloccati da Zero', hint: 'Base · A1-A2' },
  { href: '/percorsi/trova-la-tua-voce', label: 'Trova la tua Voce', hint: 'Intermedio · B1-B2' },
  { href: '/percorsi/esplora-la-lingua', label: 'Esplora la Lingua', hint: 'Avanzato · C1-C2' },
  { href: '/club-del-libro', label: 'Club del Libro', hint: 'Bonus · club tematici' },
];
---

<header>
  <div class="wrap navrow">
    <a href="/" class="brandmark">
      <img src="/logo.png" alt="Logo L'Italiano è Servito" width="44" height="44" class="logo-img" />
      <div class="brandname">L'Italiano<span>è servito</span></div>
    </a>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/chi-sono">Chi Sono</a></li>
        <li class="has-dropdown">
          <a href="/percorsi">I Percorsi ▾</a>
          <div class="dropdown">
            {percorsiLinks.map(link => (
              <a href={link.href} class="dropdown-item">
                <span class="label">{link.label}</span>
                <span class="hint">{link.hint}</span>
              </a>
            ))}
          </div>
        </li>
        <li><a href="/approfondimenti">Approfondimenti</a></li>
        <li><a href="/contatti">Contatti</a></li>
      </ul>
    </nav>
    <div class="nav-right">
      <!-- Voce evidenziata, da aggiornare a ogni semestre (oggi punta alla landing ads) -->
      <a href="/landing-ads" class="cta-nav">Corsi I semestre 2026/27</a>
      <div class="langsel">
        <a href="/" class="active">IT</a>·<a href="/pl">PL</a>·<a href="/en">EN</a>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(250,246,239,0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--card-line);
  }
  .navrow { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; }
  .brandmark { display: flex; align-items: center; gap: 12px; }
  .logo-img { display: block; width: 44px; height: 44px; object-fit: contain; }
  .brandname { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; line-height: 1.1; color: var(--ink); }
  .brandname span { display: block; font-family: var(--font-script); font-size: 1rem; color: var(--green); font-weight: 700; }
  nav ul { list-style: none; display: flex; gap: 30px; margin: 0; padding: 0; align-items: center; }
  nav a { font-size: 0.95rem; font-weight: 500; color: var(--ink-soft); }
  nav a:hover { color: var(--red); }
  .nav-right { display: flex; align-items: center; gap: 20px; }
  .cta-nav {
    background: var(--green); color: #fff; font-weight: 600; font-size: 0.85rem;
    padding: 9px 16px; border-radius: 100px; white-space: nowrap;
    transition: background .2s ease, transform .2s ease;
  }
  .cta-nav:hover { background: #24543f; color: #fff; transform: translateY(-1px); }
  .langsel { display: flex; gap: 6px; font-size: 0.85rem; font-weight: 600; color: var(--ink-soft); }
  .langsel a.active { color: var(--red); }

  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(6px);
    background: var(--bg); border: 1px solid var(--card-line); border-radius: 12px;
    box-shadow: 0 18px 34px -16px rgba(43,36,30,0.28);
    padding: 8px; min-width: 240px;
    display: flex; flex-direction: column; gap: 2px;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .dropdown-item {
    display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
    padding: 9px 12px; border-radius: 8px; font-size: 0.9rem;
  }
  .dropdown-item:hover { background: var(--card); color: var(--red); }
  .dropdown-item .hint { font-size: 0.74rem; color: var(--ink-soft); white-space: nowrap; }
  .dropdown-item:last-child { border-top: 1px solid var(--card-line); margin-top: 4px; padding-top: 12px; }

  @media (max-width: 820px) {
    nav ul { display: none; }
  }
</style>

