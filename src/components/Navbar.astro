---
const links = [
  { href: '/', label: 'Home' },
  { href: '/chi-sono', label: 'Chi Sono' },
  { href: '/contatti', label: 'Contatti' },
];

const percorsiLinks = [
  { href: '/percorsi/sbloccati-da-zero', label: 'Sbloccati da Zero', hint: 'Base · A1-A2' },
  { href: '/percorsi/trova-la-tua-voce', label: 'Trova la tua Voce', hint: 'Intermedio · B1-B2' },
  { href: '/percorsi/esplora-la-lingua', label: 'Esplora la Lingua', hint: 'Avanzato · C1-C2' },
  { href: '/club-del-libro', label: 'Club del Libro', hint: 'Bonus · club tematici' },
];
---

<header>
  <div class="wrap navrow">
    <button type="button" id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Apri il menu">
      <span></span><span></span><span></span>
    </button>
    <a href="/" class="brandmark">
      <img src="/logo.png" alt="Logo L'Italiano è Servito" width="44" height="44" class="logo-img" />
      <div class="brandname">L'Italiano<span>è servito</span></div>
    </a>
    <nav class="desktop-nav">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/chi-sono">Chi Sono</a></li>
        <li class="has-dropdown">
          <a href="/percorsi">I Percorsi ▾</a>
          <div class="dropdown">
            {percorsiLinks.map(link => (
              <a href={link.href} class="dropdown-item">
                <span class="label">{link.label}</span>
                <span class="hint">{link.hint}</span>
              </a>
            ))}
          </div>
        </li>
          <li><a href="/contatti">Contatti</a></li>
      </ul>
    </nav>
    <div class="nav-right">
      <!-- Voce evidenziata, da aggiornare a ogni semestre (oggi punta alla landing ads) -->
      <a href="/landing-ads" class="cta-nav">
        <span class="cta-full">Corsi I semestre 2026/27</span>
        <span class="cta-short">Iscriviti</span>
      </a>
      <div class="langsel">
        <a href="/" class="active">IT</a>·<a href="/pl">PL</a>·<a href="/en">EN</a>
      </div>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" hidden>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/chi-sono">Chi Sono</a></li>
      <li class="mobile-group">
        <span class="mobile-group-label">I Percorsi</span>
        <ul class="mobile-sublist">
          {percorsiLinks.map(link => (
            <li>
              <a href={link.href}>
                <span class="label">{link.label}</span>
                <span class="hint">{link.hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </li>
      <li><a href="/contatti">Contatti</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const stavaAperto = !menu.hidden;
      menu.hidden = stavaAperto;
      toggle.setAttribute('aria-expanded', String(!stavaAperto));
      toggle.classList.toggle('open', !stavaAperto);
    });
    // Chiude il menu quando si sceglie un link, utile su mobile dopo la navigazione.
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.classList.remove('open');
      });
    });
  }
</script>

<style>
  header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(250,246,239,0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--card-line);
  }
  .navrow { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; flex-wrap: wrap; row-gap: 10px; column-gap: 14px; }
  .brandmark { display: flex; align-items: center; gap: 12px; }
  .logo-img { display: block; width: 44px; height: 44px; object-fit: contain; flex-shrink: 0; }
  .brandname { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; line-height: 1.1; color: var(--ink); }
  .brandname span { display: block; font-family: var(--font-script); font-size: 1rem; color: var(--green); font-weight: 700; }
  .desktop-nav ul { list-style: none; display: flex; gap: 30px; margin: 0; padding: 0; align-items: center; }
  .desktop-nav a { font-size: 0.95rem; font-weight: 500; color: var(--ink-soft); }
  .desktop-nav a:hover { color: var(--red); }
  .nav-right { display: flex; align-items: center; gap: 20px; }
  .cta-nav {
    background: var(--green); color: #fff; font-weight: 600; font-size: 0.85rem;
    padding: 9px 16px; border-radius: 100px; white-space: nowrap;
    transition: background .2s ease, transform .2s ease;
  }
  .cta-nav:hover { background: #24543f; color: #fff; transform: translateY(-1px); }
  .cta-nav .cta-short { display: none; }
  .langsel { display: flex; gap: 6px; font-size: 0.85rem; font-weight: 600; color: var(--ink-soft); white-space: nowrap; }
  .langsel a.active { color: var(--red); }

  /* Hamburger: nascosto su desktop, mostrato sotto gli 820px insieme al menu mobile. */
  .menu-toggle {
    display: none; flex-direction: column; justify-content: center; align-items: center;
    gap: 5px; width: 40px; height: 40px; padding: 0; border: none; background: transparent;
    cursor: pointer; flex-shrink: 0; border-radius: 8px;
  }
  .menu-toggle:hover { background: var(--card); }
  .menu-toggle span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s ease, opacity .2s ease; }
  .menu-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Pannello del menu mobile: elenco verticale con "I Percorsi" già espanso
     (niente accordion, su mobile lo spazio verticale non manca come in orizzontale). */
  .mobile-menu { display: none; border-top: 1px solid var(--card-line); }
  .mobile-menu ul { list-style: none; margin: 0; padding: 10px 0; }
  .mobile-menu > ul > li { border-bottom: 1px solid var(--card-line); }
  .mobile-menu > ul > li:last-child { border-bottom: none; }
  .mobile-menu > ul > li > a {
    display: block; padding: 14px 4px; font-size: 1rem; font-weight: 600; color: var(--ink);
  }
  .mobile-group { padding: 6px 4px 10px; }
  .mobile-group-label { display: block; padding: 10px 0 4px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: var(--ink-soft); }
  .mobile-sublist { padding: 0 0 0 10px !important; display: flex; flex-direction: column; gap: 2px; }
  .mobile-sublist a { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 10px 8px; border-radius: 8px; font-size: 0.92rem; font-weight: 500; color: var(--ink-soft); }
  .mobile-sublist a:hover, .mobile-sublist a:active { background: var(--card); color: var(--red); }
  .mobile-sublist .hint { font-size: 0.72rem; color: var(--ink-soft); white-space: nowrap; }

  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(6px);
    background: var(--bg); border: 1px solid var(--card-line); border-radius: 12px;
    box-shadow: 0 18px 34px -16px rgba(43,36,30,0.28);
    padding: 8px; min-width: 240px;
    display: flex; flex-direction: column; gap: 2px;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .dropdown-item {
    display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
    padding: 9px 12px; border-radius: 8px; font-size: 0.9rem;
  }
  .dropdown-item:hover { background: var(--card); color: var(--red); }
  .dropdown-item .hint { font-size: 0.74rem; color: var(--ink-soft); white-space: nowrap; }
  .dropdown-item:last-child { border-top: 1px solid var(--card-line); margin-top: 4px; padding-top: 12px; }

  @media (max-width: 820px) {
    .desktop-nav { display: none; }
    .menu-toggle { display: flex; }
    .brandname { display: none; }
    .cta-nav .cta-full { display: none; }
    .cta-nav .cta-short { display: inline; }
    .cta-nav { padding: 9px 14px; }
    .mobile-menu:not([hidden]) { display: block; }
  }
</style>

