---
const items = [
  { name: 'Autonomia', text: 'Viaggi in Italia senza mai perderti.' },
  { name: 'Voce', text: 'Parli senza il terrore del giudizio.' },
  { name: 'Cultura', text: 'Entri nei gesti, nelle tradizioni, nel modo di pensare italiano.' },
];
---

<section class="promessa-strip">
  <div class="wrap">
    <div class="strip reveal">
      {items.map((item, i) => (
        <>
          <div class="item">
            <span class="name">{item.name}</span>
            <span class="text">{item.text}</span>
          </div>
          {i < items.length - 1 && <span class="sep" aria-hidden="true">·</span>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .promessa-strip { padding: 40px 0; background: var(--green); }
  .strip { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 22px; text-align: center; }
  .item { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .item .name { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: #fff; }
  .item .text { color: rgba(255,255,255,0.85); font-size: 0.92rem; }
  .sep { color: rgba(255,255,255,0.4); font-size: 1.2rem; }
  @media (max-width: 700px) {
    .sep { display: none; }
    .strip { flex-direction: column; gap: 14px; }
  }
</style>
