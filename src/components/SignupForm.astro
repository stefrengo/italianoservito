---
// Form di iscrizione riutilizzabile — stesso form, stesso endpoint
// (/api/iscrizione), sia su /offerta-formativa (tutti i corsi della stagione) sia
// sulle singole pagine /percorsi/* (solo i corsi di quel percorso). Iscriversi
// dalla landing o dalla pagina del corso deve essere un'esperienza identica.
//
// I corsi "Dolce" (Club del Libro, Tè e Riviste) sono gestiti a parte, non
// tramite la prop "corsi": sono bonus di conversazione validi sitewide, quindi
// il banner "voglio abbinare anche..." li propone sempre entrambi, su ogni
// pagina che monta questo form.
//
// Props:
//   corsi: [{ tag, livello }]  — corsi da proporre nel select (obbligatorio)
//   includiClubStandalone: bool — mostra "Il Club del Libro (solo)" e "Tè e
//                                  Riviste (solo)" tra le opzioni del select
//                                  (solo sulla landing, non sulle pagine percorso)
//   titolo, intro: testi della sezione, personalizzabili per contesto
//   fonte: da quale pagina arriva il lead (es. 'offerta-formativa', 'percorso:sbloccati-da-zero'),
//          salvata su Supabase per sapere dove si iscrive di più la gente

import { corsiDolce } from '../data/corsiStagione.js';
import { traduciData } from '../lib/traduciData.js';

// Nome del corso da mostrare nel form, tradotto per PL/EN (stessa
// traduzione usata nelle FAQ e nelle card di /offerta-formativa) — il
// valore inviato al form/a Supabase resta sempre il "tag" italiano, per
// non disallineare i dati coi lead già raccolti (vedi anche
// src/data/corsiStagione.js e src/lib/traduciData.js).
function nomeCorso(c, locale) {
  if (locale === 'pl') return c.tagPl || c.tag;
  if (locale === 'en') return c.tagEn || c.tag;
  return c.tag;
}

// locale: 'it' (default) | 'pl' | 'en' — traduce le etichette fisse del
// form (vedi tabella "Stringhe condivise" nella bozza traduzioni). titolo/
// intro restano personalizzabili via prop per contesto (pagine percorso),
// ma di default seguono la lingua.
const {
  corsi,
  includiClubStandalone = false,
  titolo,
  intro,
  fonte = 'sconosciuta',
  locale = 'it',
} = Astro.props;

const L = {
  it: {
    titolo: 'Iscriviti ora',
    intro: "Compila il modulo per prenotare il tuo posto: non è una semplice richiesta di informazioni, è la tua iscrizione. Ti confermo tutto via email appena la ricevo.",
    nome: 'Nome', email: 'Email', telefono: 'Telefono (anche WhatsApp)', telefonoPh: 'Es. +48 123 456 789',
    quale: 'A quale corso vuoi iscriverti?', scegli: 'Scegli il corso', solo: '(solo)',
    nonDeciso: 'Non ho ancora deciso, aiutami a scegliere',
    bundleIntro: 'Vuoi abbinare anche un club di conversazione? (prezzo bundle da confermare via email)',
    bundleVoglio: (tag, orario, prezzo) => `Voglio abbinare anche <strong>${tag}</strong>, ${orario} (a partire da PLN ${prezzo}).`,
    raccontami: 'Raccontami di più (facoltativo)',
    raccontamiPh: 'Il tuo livello, i tuoi obiettivi, qualunque dubbio: aiutami a capire qual è il corso giusto per te.',
    newsletter: 'Iscrivimi anche alla newsletter',
    privacy: 'Ho letto e accetto la Privacy Policy', privacyHref: '/privacy',
    submit: 'Prenota il tuo posto',
  },
  pl: {
    titolo: 'Zapisz się teraz',
    intro: 'Wypełnij formularz, żeby zarezerwować swoje miejsce: to nie jest zwykłe zapytanie o informacje, to Twój zapis. Potwierdzę wszystko mailowo, jak tylko go otrzymam.',
    nome: 'Imię', email: 'Email', telefono: 'Telefon (także WhatsApp)', telefonoPh: 'Np. +48 123 456 789',
    quale: 'Na jaki kurs chcesz się zapisać?', scegli: 'Wybierz kurs', solo: '(samodzielnie)',
    nonDeciso: 'Jeszcze nie zdecydowałam/em, pomóż mi wybrać',
    bundleIntro: 'Chcesz dołączyć też do klubu konwersacyjnego? (cenę pakietu potwierdzę mailowo)',
    bundleVoglio: (tag, orario, prezzo) => `Chcę dołączyć też do <strong>${tag}</strong>, ${orario} (już od ${prezzo} PLN).`,
    raccontami: 'Opowiedz mi więcej o Tobie (opcjonalnie)',
    raccontamiPh: 'Twój poziom, Twoje cele, wszelkie wątpliwości: pomóż mi zrozumieć, który kurs będzie dla Ciebie odpowiedni.',
    newsletter: 'Zapisz mnie też na newsletter',
    privacy: 'Przeczytałam/em i akceptuję Politykę Prywatności', privacyHref: '/privacy',
    submit: 'Zarezerwuj swoje miejsce',
  },
  en: {
    titolo: 'Enroll now',
    intro: "Fill in the form to reserve your spot: this isn't a simple information request, it's your enrollment. I'll confirm everything by email as soon as I receive it.",
    nome: 'Name', email: 'Email', telefono: 'Phone (WhatsApp works too)', telefonoPh: 'E.g. +48 123 456 789',
    quale: 'Which course would you like to join?', scegli: 'Choose a course', solo: '(standalone)',
    nonDeciso: "I haven't decided yet, help me choose",
    bundleIntro: 'Would you like to add a conversation club too? (bundle price to be confirmed by email)',
    bundleVoglio: (tag, orario, prezzo) => `I'd also like to add <strong>${tag}</strong>, ${orario} (starting from PLN ${prezzo}).`,
    raccontami: 'Tell me more (optional)',
    raccontamiPh: 'Your level, your goals, any doubts: help me understand which course is right for you.',
    newsletter: 'Sign me up for the newsletter too',
    privacy: 'I have read and accept the Privacy Policy', privacyHref: '/privacy',
    submit: 'Reserve your spot',
  },
}[locale];

const T = { titolo: titolo ?? L.titolo, intro: intro ?? L.intro };
---

<section id="iscrizione" class="iscrizione-section">
  <div class="wrap">
    <div class="form-card reveal">
      <div class="section-head">
        <h2>{T.titolo}</h2>
        <p class="intro">{T.intro}</p>
      </div>
      <form class="signup-form" method="POST" action="/api/iscrizione">
        <input type="hidden" name="fonte" value={fonte} />
        <!-- Campo trappola anti-spam: invisibile per una persona reale (fuori
             schermo via CSS, escluso dal tab con tabindex="-1"), ma un bot che
             legge l'HTML e compila tutti i campi lo riempie. Se arriva pieno,
             /api/iscrizione scarta la richiesta senza salvare né mandare email. -->
        <div class="hp-field" aria-hidden="true">
          <label for="sito-web-hp">Non compilare questo campo</label>
          <input type="text" id="sito-web-hp" name="sito_web" tabindex="-1" autocomplete="off" />
        </div>
        <div class="row">
          <label>{L.nome}<input type="text" name="nome" required /></label>
          <label>{L.email}<input type="email" name="email" required /></label>
        </div>
        <label>
          {L.telefono}
          <input type="tel" name="telefono" placeholder={L.telefonoPh} required />
        </label>
        <label>
          {L.quale}
          <select name="percorso" id="corso-select" required>
            <option value="">{L.scegli}</option>
            {corsi.map((c) => {
              const eDolce = corsiDolce.some((d) => d.tag === c.tag);
              return (
                <option value={`${c.tag} · ${c.livello}`} data-standalone={eDolce ? 'true' : undefined}>{nomeCorso(c, locale)} · {c.livello}</option>
              );
            })}
            {includiClubStandalone && corsiDolce.map((c) => (
              <option value={`${c.tag} (solo)`} data-standalone="true">{nomeCorso(c, locale)} {L.solo}</option>
            ))}
            <option value="Non ho ancora deciso">{L.nonDeciso}</option>
          </select>
        </label>
        <div id="bundle-wrap" class="conditional-field" hidden>
          <p class="bundle-intro">{L.bundleIntro}</p>
          {corsiDolce.map((c) => (
            <label class="checkbox bundle">
              <input type="checkbox" name={c.tag === 'Il Club del Libro' ? 'club_del_libro' : 'te_e_riviste'} value="si" />
              <span set:html={L.bundleVoglio(nomeCorso(c, locale), traduciData(c.orario, locale), c.prezzoBundle)} />
            </label>
          ))}
        </div>
        <div id="messaggio-wrap" class="conditional-field" hidden>
          <label>
            {L.raccontami}
            <textarea name="messaggio" rows="4" placeholder={L.raccontamiPh}></textarea>
          </label>
        </div>
        <label class="checkbox">
          <input type="checkbox" name="newsletter" value="si" />
          <span>{L.newsletter}</span>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="privacy" required />
          <span>{L.privacy} <a href={L.privacyHref}>Privacy Policy</a> *</span>
        </label>
        <button type="submit" class="btn">{L.submit}</button>
      </form>
    </div>
  </div>
</section>

<script>
  // Bottoni "Prenota il tuo posto" (es. sulle price-card della landing): scorrono
  // al form e pre-selezionano il corso, se presente nella pagina.
  document.querySelectorAll('[data-corso]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const select = document.getElementById('corso-select');
      if (select) {
        select.value = btn.getAttribute('data-corso');
        select.dispatchEvent(new Event('change'));
      }
      document.getElementById('iscrizione')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Campi condizionali in base al corso scelto:
  // - il bundle (Club del Libro / Tè e Riviste) ha senso solo se hai scelto un
  //   corso vero e proprio (non se hai già scelto uno dei due "(solo)", e non
  //   se non hai ancora deciso)
  // - il campo messaggio si apre solo quando chiedi aiuto a scegliere
  const corsoSelect = document.getElementById('corso-select');
  const bundleWrap = document.getElementById('bundle-wrap');
  const messaggioWrap = document.getElementById('messaggio-wrap');
  if (corsoSelect && bundleWrap && messaggioWrap) {
    const bundleCheckboxes = bundleWrap.querySelectorAll('input[type="checkbox"]');
    corsoSelect.addEventListener('change', () => {
      const valore = corsoSelect.value;
      const opzioneScelta = corsoSelect.selectedOptions[0];
      const eStandalone = opzioneScelta?.dataset.standalone === 'true';
      const eCorsoVero = valore !== '' && valore !== 'Non ho ancora deciso' && !eStandalone;
      bundleWrap.hidden = !eCorsoVero;
      if (!eCorsoVero) bundleCheckboxes.forEach((cb) => { cb.checked = false; });
      messaggioWrap.hidden = valore !== 'Non ho ancora deciso';
    });
  }
</script>

<style>
  .iscrizione-section { padding: 20px 0 80px; }
  .form-card { max-width: 640px; margin: 0 auto; background: var(--card); border: 1px solid var(--card-line); border-radius: var(--radius); padding: 40px; }
  .section-head h2 { font-size: clamp(1.3rem,2.2vw,1.7rem); margin-bottom: 10px; }
  .section-head .intro { color: var(--ink-soft); }
  .signup-form { display: flex; flex-direction: column; gap: 16px; margin-top: 24px; }
  .hp-field { position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .signup-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .signup-form label { display: flex; flex-direction: column; gap: 6px; font-size: 0.9rem; font-weight: 500; color: var(--ink-soft); }
  .signup-form input[type="text"], .signup-form input[type="email"], .signup-form input[type="tel"], .signup-form select, .signup-form textarea {
    font-family: var(--font-body); font-size: 1rem; border: 1.5px solid var(--card-line); border-radius: 12px;
    padding: 12px 14px; background: #fff; color: var(--ink); width: 100%; box-sizing: border-box;
  }
  .signup-form textarea { resize: vertical; min-height: 90px; font-family: var(--font-body); }
  .signup-form label.checkbox { flex-direction: row; align-items: flex-start; gap: 10px; font-size: 0.85rem; }
  .signup-form label.checkbox input { margin-top: 3px; }
  .signup-form label.checkbox a { color: var(--red); font-weight: 600; }
  .conditional-field[hidden] { display: none; }
  .conditional-field { display: flex; flex-direction: column; gap: 10px; }
  .bundle-intro { font-size: 0.85rem; color: var(--ink-soft); margin: 0; font-weight: 500; }
  .signup-form label.checkbox.bundle {
    background: var(--green-soft); border: 1px solid var(--green); border-radius: 12px; padding: 12px 14px;
  }
  .signup-form label.checkbox.bundle strong { color: var(--green); }
  .signup-form button { margin-top: 4px; }

  @media (max-width: 820px) {
    .signup-form .row { grid-template-columns: 1fr; }
  }
</style>
