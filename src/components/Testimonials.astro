---
// Le testimonianze di Kamila e Małgosia sono tradotte dal polacco (testo
// originale ricevuto da Stefano); quella di Marta è un placeholder inventato
// in attesa di una testimonianza reale per il Club del Libro.
const testimonianze = [
  { nome: 'Kamila, corso Sbloccati da Zero', testo: '"Professionalità autentica, unita a un modo intelligente e divertente di insegnare la lingua."' },
  { nome: 'Małgosia, corso Trova la tua Voce', testo: '"Consiglio vivamente Giada — un\'insegnante professionale e calorosa, con cui impari a conversare in italiano con naturalezza, e nei momenti di difficoltà puoi chiederle spiegazioni in polacco per capire bene quello che ti serve. Iscrivermi a un suo corso è stata una delle cose più belle che ho fatto per me stessa ultimamente, e di certo non finirà con un solo semestre."' },
  { nome: 'Marta, Club del Libro', testo: '"Il Club del Libro è il motivo per cui il mio italiano non si è mai fermato dopo la fine del corso. Ogni due settimane è un\'ora che aspetto con piacere — tra un libro e una chiacchierata, non sembra nemmeno una lezione."' },
];
---

<section class="testimonianze">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Voci</span>
      <h2>Chi ha già trovato il suo percorso</h2>
    </div>
    <div class="grid">
      {testimonianze.map((t, i) => (
        <div class={`card reveal d${i}`}>
          <span class="script quote-mark">"</span>
          <p class="testo">{t.testo}</p>
          <p class="nome">— {t.nome}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonianze { padding: 60px 0; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card { background: var(--card); border: 1px solid var(--card-line); border-radius: var(--radius); padding: 26px 24px; }
  .quote-mark { color: var(--gold); font-size: 1.8rem; display: block; margin-bottom: 4px; line-height: 1; }
  .testo { font-family: var(--font-display); font-style: italic; color: var(--ink); font-size: 0.98rem; line-height: 1.5; margin: 0 0 14px; }
  .nome { margin: 0; font-size: 0.82rem; color: var(--ink-soft); font-weight: 600; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
