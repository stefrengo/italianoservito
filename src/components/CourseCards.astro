---
import { corsi } from '../data/corsi.js';
const c = corsi;

const tiles = [
  {
    n: '01', label: 'Antipasto', tint: 'ink',
    title: c['sbloccati-da-zero'].title, badge: c['sbloccati-da-zero'].badge,
    text: c['sbloccati-da-zero'].lede, href: '/percorsi/sbloccati-da-zero',
    img: '/foto/corsi/antipasto.jpg', pos: 'center',
  },
  {
    n: '02', label: 'Primo', tint: 'green',
    title: c['trova-la-tua-voce'].title, badge: c['trova-la-tua-voce'].badge,
    text: c['trova-la-tua-voce'].lede, href: '/percorsi/trova-la-tua-voce',
    img: '/foto/corsi/primo.jpg', pos: 'center',
  },
  {
    n: '03', label: 'Secondo', tint: 'deep',
    title: c['esplora-la-lingua'].title, badge: c['esplora-la-lingua'].badge,
    text: c['esplora-la-lingua'].lede, href: '/percorsi/esplora-la-lingua',
    img: '/foto/corsi/secondo.jpg', pos: 'center',
  },
  {
    n: '04', label: 'Dolce', tint: 'gold',
    title: 'Club del Libro & club tematici', badge: 'Bonus',
    text: 'Il bonus dopo il pasto: incontri ricorrenti per non perdere quello che hai costruito.',
    href: '/club-del-libro', img: '/foto/giada-3-libro.jpg', pos: 'center 12%',
  },
];
---

<div class="tiles">
  {tiles.map((t, i) => (
    <a href={t.href} class={`tile tint-${t.tint} reveal d${i % 4}`}>
      <img src={t.img} alt={t.title} style={`object-position:${t.pos};`} />
      <div class="wash"></div>
      <div class="scrim"></div>
      <div class="body">
        <span class="n">{t.n}</span>
        <span class="stamp ink">{t.label}</span>
        <h3>{t.title}</h3>
        <p class="badge-line">{t.badge}</p>
        <p class="desc">{t.text}</p>
        <span class="go">Scopri di più</span>
      </div>
    </a>
  ))}
</div>

<style>
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .tile {
    position: relative; display: block; overflow: hidden; border-radius: 8px;
    aspect-ratio: 3 / 4; color: #fff; isolation: isolate;
  }
  .tile img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.55) contrast(1.02);
    transition: transform 6s ease, filter .4s ease;
  }
  .tile:hover img { transform: scale(1.08); filter: saturate(0.9) contrast(1.02); }

  .wash {
    position: absolute; inset: 0; mix-blend-mode: color; opacity: 0.55;
    transition: opacity .35s ease, background-color .35s ease;
  }
  .tint-ink .wash { background: #3a3128; }
  .tint-green .wash { background: var(--green); }
  .tint-deep .wash { background: #234a3a; }
  .tint-gold .wash { background: var(--gold); }
  .tile:hover .wash { opacity: 0.85; }

  .scrim {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(15,12,9,0.92) 0%, rgba(15,12,9,0.35) 45%, rgba(15,12,9,0.05) 70%);
  }

  .body { position: absolute; inset: 0; z-index: 2; padding: 18px; display: flex; flex-direction: column; justify-content: flex-end; }
  .n { font-family: var(--font-display); font-size: 0.8rem; opacity: 0.75; margin-bottom: auto; }
  .stamp { align-self: flex-start; margin-bottom: 10px; background: rgba(250,246,239,0.92); }
  .body h3 { font-size: 1.15rem; color: #fff; margin-bottom: 2px; line-height: 1.2; }
  .badge-line { margin: 0 0 8px; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.04em; color: #EFE7D8; opacity: 0.85; }
  .desc {
    margin: 0 0 10px; font-size: 0.85rem; color: #F2ECDF; line-height: 1.4;
    max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height .35s ease, opacity .35s ease, margin .35s ease;
  }
  .tile:hover .desc { max-height: 120px; opacity: 1; }
  .go {
    font-weight: 600; font-size: 0.82rem; color: #fff;
    border-bottom: 1.5px solid var(--gold); padding-bottom: 2px; align-self: flex-start;
    opacity: 0; transform: translateY(6px);
    transition: opacity .3s ease, transform .3s ease;
  }
  .tile:hover .go { opacity: 1; transform: translateY(0); }

  @media (max-width: 980px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
    .tile { aspect-ratio: 4 / 3; }
    .desc, .go { max-height: none; opacity: 1; transform: none; } /* su touch, contenuto sempre visibile */
  }
  @media (max-width: 560px) {
    .tiles { grid-template-columns: 1fr; }
  }
</style>
