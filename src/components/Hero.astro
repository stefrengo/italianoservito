---
const {
  eyebrow = 'Ciao, sono Giada!',
  title = "Non lezioni di italiano.<br>Un percorso per entrare <em>nel cuore</em> dell'Italia.",
  lede = "Corsi online di italiano per chi si è innamorato dell'Italia. Con Giada Longo, insegnante certificata che capisce esattamente dove ti blocchi — perché ci è passata anche lei, dall'altra parte.",
  ctaLabel = 'Trova il tuo percorso in italiano',
  ctaHref = '/percorsi',
  ghostLabel = 'Scopri la mia storia',
  ghostHref = '/chi-sono',
  showCollage = true,
} = Astro.props;
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={title} />
      {lede && <p class="lede">{lede}</p>}
      <div class="cta-row">
        <a class="btn" href={ctaHref}>{ctaLabel}</a>
        {ghostLabel && <a class="btn ghost" href={ghostHref}>{ghostLabel} →</a>}
      </div>
    </div>
    {showCollage && (
      <div class="hero-collage reveal d1">
        <div class="postcards">
          <div class="postcard"><img src="/foto/cartoline/roma.jpg" alt="Cartolina da Roma" /></div>
          <div class="postcard"><img src="/foto/cartoline/venezia.jpg" alt="Cartolina da Venezia" /></div>
          <div class="postcard"><img src="/foto/cartoline/toscana.jpg" alt="Cartolina dalla Toscana" /></div>
          <div class="postcard"><img src="/foto/cartoline/genova.jpg" alt="Cartolina da Genova" /></div>
        </div>
        <div class="photo main torn-bottom"><img src="/foto/giada-1.png" alt="Giada Longo" /></div>
      </div>
    )}
  </div>
</section>

<style>
  .hero { padding: 70px 0 40px; }
  .hero-grid { display: grid; grid-template-columns: 0.95fr 1.15fr; gap: 50px; align-items: center; }
  .hero h1 { font-size: clamp(2rem, 3.4vw, 2.9rem); line-height: 1.14; margin-bottom: 20px; }
  .hero h1 :global(em) { font-style: italic; color: var(--green); }
  .lede { font-size: 1.05rem; color: var(--ink-soft); max-width: 44ch; margin-bottom: 28px; }
  .cta-row { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }

  .hero-collage { display: flex; align-items: stretch; gap: 16px; height: 400px; }
  .hero-collage .photo.main { position: relative; flex: 1; border-radius: 4px 120px 4px 4px; }

  .postcards { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; width: 92px; flex-shrink: 0; }
  .postcard {
    flex: 1; overflow: hidden; border-radius: 3px; background: var(--bg);
    border: 5px solid var(--bg); box-shadow: 0 10px 20px -10px rgba(43,36,30,0.4);
  }
  .postcard img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .postcards .postcard:nth-child(1) { transform: rotate(-3deg); }
  .postcards .postcard:nth-child(2) { transform: rotate(2deg); }
  .postcards .postcard:nth-child(3) { transform: rotate(-2deg); }
  .postcards .postcard:nth-child(4) { transform: rotate(3deg); }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-collage { order: -1; height: 320px; }
    .postcards { width: 70px; }
  }
  @media (max-width: 560px) {
    .postcards { display: none; }
  }
</style>
