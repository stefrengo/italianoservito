---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import PromiseCards from '../components/PromiseCards.astro';
import CourseCards from '../components/CourseCards.astro';
import SafeSpace from '../components/SafeSpace.astro';
import Testimonials from '../components/Testimonials.astro';

// Le 3 FAQ qui sotto sono pensate apposta per la Home (taglio più "da campagna",
// pensate anche per un assistente AI che cerca risposte rapide) e restano
// distinte da quelle generali in src/data/faq.js, usate sulla pagina /faq.
const faqHome = [
  {
    q: 'Cosa succede se ho paura di parlare?',
    a: 'È il punto di partenza, non un ostacolo. Nei primi incontri lavoro apposta per abbassare la pressione: si parla un po\', si ascolta tanto, e la fiducia cresce lezione dopo lezione.',
  },
  {
    q: 'Come si svolgono le lezioni per studenti polacchi?',
    a: 'Costruisco le lezioni tenendo conto delle difficoltà specifiche delle persone polacche e le affronto insieme a te con paragoni che a me, come madrelingua italiana, non sarebbero mai venuti in mente prima di studiare la lingua polacca e vivere in Polonia.',
  },
  {
    q: 'Devo già sapere un po\' di italiano per iniziare?',
    a: 'Non è necessario: ho pensato "Sbloccati da Zero" apposta per chi parte da zero.',
  },
];
---

<MainLayout>
  <Hero ctaHref="/offerta-formativa" />

  <section class="promessa">
    <div class="wrap narrow reveal">
      <p>Non ti insegnerò solo la grammatica. Ti accompagnerò a costruire la sicurezza per tentare, sbagliare, ridere dell'errore e riprovare, finché l'italiano non sarà più "una lingua straniera da studiare", ma un pezzo di te.</p>
    </div>
  </section>

  <PromiseCards />

  <section id="percorsi">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">I percorsi</span>
      </div>
      <CourseCards />
    </div>
  </section>

  <SafeSpace />

  <Testimonials />

  <section class="faq-home">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Domande frequenti</span>
        <h2>Le domande che mi fanno più spesso</h2>
      </div>
      <div class="faq-home-list">
        {faqHome.map((item) => (
          <details class="reveal">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <div class="wrap reveal" style="text-align:center; margin-top:30px; padding:0;">
        <a class="btn ghost" href="/faq">Vedi tutte le domande frequenti →</a>
      </div>
    </div>
  </section>

  <section class="finale">
    <div class="wrap finale-grid">
      <div class="chi-teaser reveal">
        <span class="eyebrow">Chi sono</span>
        <h2>Prima di essere la tua insegnante,<br>sono stata per quasi 7 anni una polacca d'adozione.</h2>
        <p>Ho vissuto a Cracovia, ho lavorato all'Istituto Italiano di Cultura, e so esattamente dove la lingua polacca ti mette i bastoni tra le ruote quando provi a parlare italiano.</p>
        <a class="btn ghost" href="/chi-sono">Scopri la mia storia →</a>
      </div>
    </div>
    <div class="wrap reveal d2" style="text-align:center; margin-top:50px;">
      <h2 style="margin-bottom:24px;">Non serve la perfezione per iniziare l'avventura.<br>Basta il primo passo.</h2>
      <a class="btn" href="/contatti">Trova il tuo percorso in italiano</a>
    </div>
  </section>
</MainLayout>

<style>
  /* Ritmo cromatico tra le sezioni della home: alterno crema (--bg) e beige
     caldo (--card), palette già esistente nel design system — nessun colore
     nuovo. Il rosso resta riservato solo alle CTA (vedi global.css). */
  .promessa { padding: 8px 0 6px; }
  .promessa .narrow { max-width: 700px; margin: 0 auto; text-align: center; }
  .promessa p { font-family: var(--font-display); font-style: italic; color: var(--ink); font-size: clamp(1.05rem,1.6vw,1.25rem); line-height: 1.55; margin: 0; }

  #percorsi { background: var(--card); }
  .faq-home { background: var(--card); padding: 54px 0 74px; }

  .faq-home-list { max-width: 720px; margin: 0 auto; }
  .faq-home-list details { border-top: 1px solid var(--card-line); padding: 16px 0; }
  .faq-home-list details:last-child { border-bottom: 1px solid var(--card-line); }
  .faq-home-list summary { font-weight: 600; cursor: pointer; }
  .faq-home-list details p { margin: 12px 0 0; color: var(--ink-soft); line-height: 1.6; }

  .finale { padding: 60px 0 80px; }
  .finale-grid { display: flex; justify-content: center; }
  .chi-teaser {
    display: flex; flex-direction: column; align-items: flex-start;
    background: var(--card); border: 1px solid var(--card-line); border-radius: var(--radius);
    padding: 34px 32px; max-width: 620px;
  }
  .finale-grid h2 { font-size: clamp(1.25rem,2vw,1.55rem); margin: 6px 0 14px; }
  .finale-grid p { color: var(--ink-soft); font-size: 0.94rem; margin-bottom: 18px; }
  .chi-teaser .btn { margin-top: auto; }
</style>
