---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contatti | Prenota la tua lezione conoscitiva | L'Italiano è Servito">
  <section class="apertura">
    <div class="wrap narrow" style="text-align:center;">
      <span class="eyebrow">Contatti</span>
      <h1>Non serve la perfezione. Basta il primo passo.</h1>
      <p class="lede">Raccontami da dove parti e insieme capiremo qual è il percorso giusto per te.</p>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <!-- Il form invia i dati a un endpoint serverless (Vercel Function) che li inoltra
           via email, mantenendo intatto il flusso Zapier -> Google Sheet già in uso da Giada.
           Collegato a functions/api/iscrizione.js (Supabase + Resend). -->
      <form class="contact-form" method="POST" action="/api/iscrizione">
        <input type="hidden" name="fonte" value="contatti" />
        <label>
          Nome
          <input type="text" name="nome" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Telefono (anche WhatsApp)
          <input type="tel" name="telefono" placeholder="Es. +48 123 456 789" required />
        </label>
        <label>
          Livello attuale
          <select name="livello">
            <option>Parto da zero</option>
            <option>Capisco ma non parlo</option>
            <option>Voglio perfezionarmi</option>
          </select>
        </label>
        <label>
          Il tuo obiettivo
          <textarea name="obiettivo" rows="4" placeholder="Es. viaggiare in Italia, parlare con più sicurezza, esplorare la cultura..."></textarea>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="privacy" required />
          <span>Ho letto e accetto la <a href="/privacy">Privacy Policy</a> *</span>
        </label>
        <button type="submit" class="btn">Prenota la lezione conoscitiva</button>
      </form>
    </div>
  </section>
</MainLayout>

<style>
  .apertura { padding: 70px 0 20px; }
  .narrow { max-width: 620px; margin: 0 auto; }
  .lede { color: var(--ink-soft); margin-top: 12px; }
  .contact-form { display: flex; flex-direction: column; gap: 18px; margin-top: 20px; }
  .contact-form label { display: flex; flex-direction: column; gap: 6px; font-size: 0.92rem; font-weight: 500; color: var(--ink-soft); }
  .contact-form input, .contact-form select, .contact-form textarea {
    font-family: var(--font-body), sans-serif; font-size: 1rem; color: var(--ink);
    border: 1.5px solid var(--card-line); border-radius: 12px; padding: 12px 14px;
    background: #fff;
  }
  .contact-form label.checkbox { flex-direction: row; align-items: flex-start; gap: 10px; font-size: 0.85rem; }
  .contact-form label.checkbox input { margin-top: 3px; width: auto; }
  .contact-form label.checkbox a { color: var(--red); font-weight: 600; }
  .contact-form button { align-self: flex-start; margin-top: 8px; }
</style>
