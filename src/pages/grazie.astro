---
// Pagina di conferma dopo l'invio del form di iscrizione (/api/iscrizione
// reindirizza qui con un redirect 303 dopo un salvataggio riuscito).
//
// Pagina UNICA per tutte e tre le lingue del sito (IT/PL/EN), anche quando
// le traduzioni PL/EN saranno pronte: qui arriveranno in futuro anche i
// pixel di tracciamento (Meta/Facebook, Google Ads, GTM...) e conviene che
// vivano in un solo punto, non duplicati in tre pagine — meno rischio di
// dimenticarli in una versione. La vecchia versione del sito (ancora live
// su italianoservito.it/grazie) fa lo stesso identico ragionamento, con un
// unico messaggio multilingua su una sola pagina.
//
// IMPORTANTE: questa pagina legge ?lang= dalla query string per scegliere il
// blocco di testo giusto, quindi NON può essere prerenderizzata come le
// altre pagine (in output "hybrid" sarebbe statica per default, e una pagina
// statica ignora la query string: verrebbe servita sempre la stessa identica
// HTML). "prerender = false" la rende on-demand, come /api/iscrizione.
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';

// Lingua passata da /api/iscrizione come ?lang=pl|en (rilevata lì dal
// Referer della pagina di provenienza — vedi iscrizione.js). Se manca o non
// è riconosciuta (es. qualcuno apre /grazie direttamente) si mostra
// l'italiano di default.
const langParam = Astro.url.searchParams.get('lang');
const lang = langParam === 'pl' || langParam === 'en' ? langParam : 'it';

// Query param "conv" — impostato SOLO da /api/iscrizione quando honeypot o
// controllo Referer bloccano una richiesta sospetta (vedi iscrizione.js):
// quel "successo" è finto, serve solo a non far capire al bot di essere
// stato scoperto, e non ha scritto nulla su Supabase né mandato email. Se
// conv=0 non dobbiamo mandare eventi di conversione reali (GA4 generate_lead,
// Meta Pixel Lead) qui sotto: altrimenti inquineremmo i dati di conversione
// con iscrizioni mai avvenute — proprio le metriche su cui vogliamo poi
// ottimizzare le sponsorizzate. Deciso con Stefano l'1/09/2026. Turnstile
// non ha questo problema: quando blocca, non arriva mai qui (risposta di
// errore diretta, nessun redirect).
const trackConversion = Astro.url.searchParams.get('conv') !== '0';

// Testo volutamente generico ("richiesta", non "iscrizione"/"posto
// prenotato"): questa pagina compare per QUALSIASI invio del form, non
// solo per chi si iscrive a un corso — anche per chi scrive dal form
// Contatti o sceglie "non ho ancora deciso, aiutami a scegliere" nella
// landing. Deciso con Stefano il 28/08/2026: più semplice ed onesto non
// promettere un posto riservato a chi ha solo fatto una domanda (vedi
// stessa scelta nella mail di conferma, src/pages/api/iscrizione.js).
const testi = {
  it: {
    htmlLang: 'it',
    stamp: 'Richiesta ricevuta',
    h1: 'Grazie! Ho ricevuto la tua richiesta.',
    lede: "Ti scrivo personalmente entro 24-48 ore, per confermarti tutti i dettagli e i prossimi passi.",
    ledeSoft: "Nel frattempo, se hai già controllato la posta e non trovi nulla, dai un'occhiata anche nella cartella spam: a volte le email di conferma finiscono lì.",
    cta: 'Torna alla home',
    ctaHref: '/',
  },
  pl: {
    htmlLang: 'pl',
    stamp: 'Zapytanie otrzymane',
    h1: 'Dziękuję! Otrzymałam Twoje zapytanie.',
    lede: 'Napiszę do Ciebie osobiście w ciągu 24-48 godzin, żeby potwierdzić wszystkie szczegóły i kolejne kroki.',
    ledeSoft: 'W międzyczasie, jeśli sprawdziłaś/eś już pocztę i nic nie widzisz, zajrzyj też do folderu spam: czasem maile potwierdzające tam trafiają.',
    cta: 'Wróć do strony głównej',
    ctaHref: '/pl',
  },
  en: {
    htmlLang: 'en',
    stamp: 'Request received',
    h1: "Thank you! I've received your request.",
    lede: "I'll write to you personally within 24-48 hours to confirm all the details and next steps.",
    ledeSoft: "In the meantime, if you've already checked your inbox and can't find anything, take a look in your spam folder too: confirmation emails sometimes end up there.",
    cta: 'Back to home',
    ctaHref: '/en',
  },
};

const t = testi[lang];
---

<MainLayout
  title="Grazie! | L'Italiano è Servito"
  description="La tua richiesta è stata ricevuta: Giada ti risponde entro 24-48 ore."
  noindex={true}
  locale={lang}
>
  <!--
    Evento di conversione: si attiva solo se GA4/Meta Pixel sono già stati
    caricati (cioè solo se il visitatore ha accettato i cookie nel banner —
    vedi CookieConsent.astro). Se il consenso non è stato dato, gtag/fbq non
    esistono e questi due "if" non fanno nulla: nessun dato inviato senza
    consenso, come richiesto dal GDPR.
  -->
  <script define:vars={{ trackConversion }}>
    if (trackConversion && typeof window.gtag === 'function') {
      window.gtag('event', 'generate_lead', { event_category: 'iscrizione' });
    }
    if (trackConversion && typeof window.fbq === 'function') {
      window.fbq('track', 'Lead');
    }
  </script>

  <section class="grazie-section">
    <div class="wrap narrow reveal">
      <span class="stamp green">{t.stamp}</span>
      <h1>{t.h1}</h1>
      <p class="lede">{t.lede}</p>
      <p class="lede-soft">{t.ledeSoft}</p>
      <div class="azioni">
        <a href={t.ctaHref} class="btn">{t.cta}</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .grazie-section { padding: 100px 0 120px; }
  .narrow { max-width: 640px; text-align: center; }
  .stamp { margin-bottom: 22px; }
  h1 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); margin-bottom: 18px; }
  .lede { font-size: 1.1rem; color: var(--ink-soft); margin: 0 0 12px; }
  .lede-soft { font-size: 0.95rem; color: var(--ink-soft); opacity: 0.8; margin: 0 0 34px; }
  .azioni { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
