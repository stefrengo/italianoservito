---
import MainLayout from '../../layouts/MainLayout.astro';
import { articoli } from '../../data/articoli.js';

export function getStaticPaths() {
  return articoli.map((a) => ({
    params: { slug: a.slug },
    props: { articolo: a },
  }));
}

const { articolo } = Astro.props;

const correlati = articoli
  .filter((a) => a.cat === articolo.cat && a.slug !== articolo.slug)
  .slice(0, 2);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articolo.seoTitle || articolo.titolo,
  description: articolo.estratto,
  image: articolo.img,
  author: { '@type': 'Person', name: 'Giada Longo', jobTitle: 'Insegnante di lingua e cultura italiana' },
  publisher: {
    '@type': 'Organization',
    name: "L'Italiano è Servito",
    url: 'https://www.italianoservito.it',
  },
  inLanguage: 'it',
  about: 'Lingua e cultura italiana per apprendenti polacchi',
};
---

<MainLayout
  title={`${articolo.seoTitle || articolo.titolo} | L'Italiano è Servito`}
  description={articolo.estratto}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article>
    <section class="apertura">
      <div class="wrap narrow reveal">
        <a href="/approfondimenti" class="back">← Tutti gli approfondimenti</a>
        <span class="cat-pill">{articolo.cat}</span>
        <h1>{articolo.titolo}</h1>
        <p class="byline">Giada Longo · {articolo.min} min di lettura</p>
      </div>
    </section>

    <section class="photo-section reveal d1">
      <div class="wrap narrow">
        <div class="photo article-photo torn-bottom">
          <img src={articolo.img} alt={articolo.imgAlt} loading="eager" />
        </div>
      </div>
    </section>

    <section class="corpo-section">
      <div class="wrap narrow reveal">
        {articolo.corpo.map((blocco) =>
          blocco.type === 'h2' ? <h2>{blocco.text}</h2> : <p>{blocco.text}</p>
        )}
        <div class="tag-row">
          {articolo.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="wrap narrow reveal" style="text-align:center;">
        <h2>Non serve la perfezione. Basta il primo passo.</h2>
        <p>Se questo tipo di approccio ti parla, forse è il momento di trovare il tuo percorso in italiano.</p>
        <a class="btn" href="/percorsi">Trova il tuo percorso in italiano</a>
      </div>
    </section>

    {correlati.length > 0 && (
      <section class="correlati-section">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">Continua a leggere</span>
            <h2>Altri approfondimenti in {articolo.cat}</h2>
          </div>
          <div class="correlati-grid">
            {correlati.map((a) => (
              <a href={`/approfondimenti/${a.slug}`} class="news-card reveal">
                <div class="thumb"><img src={a.img} alt={a.imgAlt} loading="lazy" /></div>
                <div class="content">
                  <span class="cat-pill">{a.cat}</span>
                  <h3>{a.titolo}</h3>
                  <p>{a.estratto}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</MainLayout>

<style>
  .apertura { padding: 60px 0 10px; }
  .narrow { max-width: 700px; margin: 0 auto; }
  .back { display: inline-block; margin-bottom: 18px; font-size: 0.88rem; color: var(--ink-soft); font-weight: 600; }
  .back:hover { color: var(--red); }
  .cat-pill {
    display: inline-block; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;
    background: var(--green-soft); color: var(--green); padding: 4px 10px; border-radius: 100px; margin-bottom: 14px;
  }
  h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.24; margin-bottom: 12px; }
  .byline { color: var(--ink-soft); font-size: 0.88rem; }

  .photo-section { padding: 20px 0; }
  .article-photo { height: 320px; border-radius: 4px 90px 4px 4px; }

  .corpo-section { padding: 10px 0 50px; }
  .corpo-section h2 { font-size: clamp(1.2rem, 2vw, 1.4rem); margin: 30px 0 14px; }
  .corpo-section p { color: var(--ink-soft); margin-bottom: 18px; font-size: 1rem; line-height: 1.7; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--card-line); }
  .tag-row .tag { font-size: 0.8rem; color: var(--ink-soft); opacity: 0.75; }

  .cta-section { padding: 20px 0 70px; }
  .cta-section h2 { font-size: clamp(1.3rem, 2.2vw, 1.6rem); margin-bottom: 10px; }
  .cta-section p { color: var(--ink-soft); margin-bottom: 22px; }

  .correlati-section { padding: 20px 0 80px; border-top: 1px solid var(--card-line); }
  .correlati-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 760px; margin: 0 auto; }
  .news-card {
    border: 1px solid var(--card-line); border-radius: var(--radius); overflow: hidden;
    background: #fff; display: flex; flex-direction: column;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .news-card:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -18px rgba(43,36,30,0.25); }
  .thumb { height: 150px; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .news-card .content { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 8px; }
  .news-card h3 { font-size: 1rem; line-height: 1.32; }
  .news-card p { margin: 0; color: var(--ink-soft); font-size: 0.86rem; line-height: 1.45; }

  @media (max-width: 700px) {
    .correlati-grid { grid-template-columns: 1fr; }
  }
</style>
