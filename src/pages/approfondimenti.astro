---
import MainLayout from '../layouts/MainLayout.astro';
import { articoli, categorie, tags } from '../data/articoli.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: "Approfondimenti — L'Italiano è Servito",
  description: "Grammatica senza stress, vita in Italia, storie e cucina: articoli per chi impara l'italiano venendo dalla Polonia.",
  hasPart: articoli.map((a) => ({
    '@type': 'Article',
    headline: a.seoTitle || a.titolo,
    url: `https://www.italianoservito.it/approfondimenti/${a.slug}`,
  })),
};
---

<MainLayout
  title="Approfondimenti — L'Italiano è Servito"
  description="Grammatica senza stress, vita in Italia, storie e cucina: piccoli approfondimenti per restare in contatto con la lingua tra una lezione e l'altra."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="apertura">
    <div class="wrap section-head reveal">
      <span class="eyebrow">Approfondimenti</span>
      <h1>Un po' di Italia anche fuori dalle lezioni</h1>
      <p class="lede">Non un blog da rincorrere ogni settimana: una piccola collezione di letture pensata per restare, non per scadere.</p>
    </div>
  </section>

  <section class="filtri-section">
    <div class="wrap">
      <div class="filtri reveal">
        <button class="pill active" data-filtro="tutti">Tutti</button>
        {categorie.map(c => <button class="pill" data-filtro={c}>{c}</button>)}
      </div>
      <div class="tags reveal d1">
        {tags.map(t => <span class="tag">{t}</span>)}
      </div>
    </div>
  </section>

  <section class="grid-section">
    <div class="wrap">
      <div class="news-grid" id="news-grid">
        {articoli.map((a, i) => (
          <a href={`/approfondimenti/${a.slug}`} class={`news-card reveal d${i % 3}`} data-cat={a.cat}>
            <div class="thumb"><img src={a.img} alt={a.imgAlt} loading="lazy" /></div>
            <div class="content">
              <span class="cat-pill">{a.cat}</span>
              <h3>{a.titolo}</h3>
              <p>{a.estratto}</p>
              <p class="byline">Giada Longo · {a.min} min di lettura</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const pills = document.querySelectorAll('.pill');
  const cards = document.querySelectorAll('.news-card');
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const filtro = pill.getAttribute('data-filtro');
      cards.forEach((card) => {
        const match = filtro === 'tutti' || card.getAttribute('data-cat') === filtro;
        card.style.display = match ? '' : 'none';
      });
    });
  });
</script>

<style>
  .apertura { padding: 60px 0 10px; }
  .lede { color: var(--ink-soft); margin-top: 14px; }

  .filtri-section { padding: 20px 0 30px; }
  .filtri { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
  .pill {
    font-family: var(--font-body); font-size: 0.85rem; font-weight: 600; color: var(--ink-soft);
    background: var(--card); border: 1px solid var(--card-line); border-radius: 100px;
    padding: 8px 16px; cursor: pointer; transition: background .2s ease, color .2s ease;
  }
  .pill:hover { background: var(--green-soft); color: var(--green); }
  .pill.active { background: var(--green); color: #fff; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .tag { font-size: 0.8rem; color: var(--ink-soft); opacity: 0.75; }

  .grid-section { padding: 10px 0 70px; }
  .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .news-card {
    border: 1px solid var(--card-line); border-radius: var(--radius); overflow: hidden;
    background: #fff; display: flex; flex-direction: column;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .news-card:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -18px rgba(43,36,30,0.25); }
  .thumb { height: 170px; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .news-card:hover .thumb img { transform: scale(1.06); }
  .content { padding: 20px 20px 22px; display: flex; flex-direction: column; gap: 8px; }
  .cat-pill {
    align-self: flex-start; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;
    background: var(--green-soft); color: var(--green); padding: 4px 10px; border-radius: 100px;
  }
  .content h3 { font-size: 1.08rem; line-height: 1.32; }
  .content p { margin: 0; color: var(--ink-soft); font-size: 0.88rem; line-height: 1.45; }
  .byline { font-size: 0.78rem; color: var(--ink-soft); opacity: 0.8; margin-top: 4px !important; }

  @media (max-width: 900px) { .news-grid { grid-template-columns: 1fr; } }
</style>
