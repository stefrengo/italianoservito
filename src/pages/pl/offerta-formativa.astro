---
// Versione polacca della landing /offerta-formativa — stessa struttura di
// dati (corsiStagione.js) della pagina italiana, con le etichette e i testi
// tradotti (vedi traduzioni-pl-en-bozza.md). Fuori dal menu di navigazione,
// come la versione italiana.
import MainLayout from '../../layouts/MainLayout.astro';
import { STAGIONE, corsiStagione, corsiDolce } from '../../data/corsiStagione.js';
import { traduciData } from '../../lib/traduciData.js';

const tutteLeCard = [
  ...corsiStagione.map((c) => ({ ...c, dolce: false })),
  ...corsiDolce.map((c) => ({ ...c, dolce: true })),
];

const stagionePiana = traduciData(STAGIONE.replace(' | ', ' '), 'pl');

const perche = [
  { titolo: 'Doświadczona native speakerka', testo: '10 lat nauczania osób dorosłych na każdym poziomie językowym.' },
  { titolo: 'Jasne wyjaśnienia także po polsku', testo: 'Rozumiesz najtrudniejszą gramatykę dzięki wsparciu w twoim ojczystym języku.' },
  { titolo: 'Praktyczne lekcje, nigdy sama teoria', testo: 'Mówisz od pierwszego dnia, w realnych sytuacjach, a kiedy gramatyka jest potrzebna, wyjaśniam ją od razu, bez zbędnych ozdobników.' },
  { titolo: 'Maksymalnie 6 osób w grupie', testo: 'Odpowiednia przestrzeń, żeby mówić i zadawać pytania na każdej lekcji.' },
];
---

<MainLayout
  locale="pl"
  title={`Kursy włoskiego ${traduciData(STAGIONE, 'pl')} | L'Italiano è Servito`}
  description="Kursy włoskiego online z Giadą Longo. Zapisy na ten sezon są zamknięte — skontaktuj się ze mną w sprawie kolejnej edycji."
>
  <section class="hero-ads">
    <div class="wrap hero-grid">
      <div class="reveal">
        <span class="stamp ink">Zapisy zamknięte</span>
        <h1>Kursy online<br>języka włoskiego</h1>
        <p class="stagione">Bo włoski to przyjemność!</p>
        <p class="lede">Cześć! Jestem Giada, nauczycielka języka i kultury włoskiej dla obcokrajowców. Po latach nauczania w Polsce założyłam „L'Italiano è Servito", żeby pomóc osobom ze świata słowiańskiego naprawdę zanurzyć się w języku włoskim, a nie tylko się go uczyć.</p>
        <p class="lede">Dla mnie nauczanie włoskiego oznacza wejście w samo serce Włoch: w gesty, smaki, tradycje.</p>
        <a class="btn" href="/pl/contatti">Skontaktuj się ze mną</a>
      </div>
      <div class="photo main-photo torn-bottom reveal d1">
        <img src="/foto/giada-1.png" alt="Giada Longo" />
      </div>
    </div>
  </section>

  <section id="corsi" class="corsi-section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Kalendarz kursów | {stagionePiana}</h2>
        <p class="intro">W tym semestrze proponuję Ci kursy online w małych grupach (od 3 do 6 osób), żeby uczyć się i doskonalić swój włoski w przyjaznej atmosferze. Niezależnie od twojego poziomu, znajdziesz kurs pomyślany właśnie dla Ciebie.</p>
      </div>

      <div class="price-grid">
        {tutteLeCard.map((c, i) => (
          <div class={`price-card reveal d${i % 3}`}>
            <div class="price-head">{traduciData(c.orario, 'pl')}</div>
            <div class="price-tag">
              <span class="stamp ink small">{c.dolce ? 'Bonus' : c.pasto}</span>
              <span class="livello">{c.livello}</span>
            </div>
            <p class="path-name">{c.tagPl}</p>
            <span class="posti-badge">Zapisy zamknięte!</span>
            <div class="price-amount"><span class="currency">PLN</span>{c.prezzo}</div>
            {c.dolce ? (
              <ul>
                <li>{c.comeFunzionaPl}</li>
                <li>{c.lezioni} lekcji po {c.minuti} minut</li>
                <li>W pakiecie z kursem: PLN {c.prezzoBundle}</li>
              </ul>
            ) : (
              <ul>
                <li>{c.tipoPl}</li>
                <li>{traduciData(c.lezioni, 'pl')}</li>
                <li>Dzień wolny: {traduciData(c.giornoLibero, 'pl')}</li>
              </ul>
            )}
          </div>
        ))}
      </div>

      <p class="info-line reveal">Potrzebujesz więcej informacji? Napisz do mnie na <a href="mailto:giada@italianoservito.it">giada@italianoservito.it</a></p>
    </div>
  </section>

  <section class="perche-section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Dlaczego warto wybrać moje kursy</h2>
      </div>
      <div class="perche-grid">
        {perche.map((p, i) => (
          <div class={`perche-item reveal d${i % 4}`}>
            <h3>{p.titolo}</h3>
            <p>{p.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="storia-section">
    <div class="storia-photo"><img src="/foto/giada-5-cane.png" alt="Giada Longo" /></div>
    <div class="storia-content">
      <div class="reveal">
        <span class="eyebrow" style="color:var(--gold);">Moja historia</span>
        <h2>Cześć! Jestem Giada Longo i mam szczęście wykonywać najpiękniejszy zawód świata: uczę włoskiego obcokrajowców.</h2>
        <p>Ukończyłam filologię ze specjalizacją w języku polskim i rosyjskim, a moja praca magisterska poświęcona była właśnie dydaktyce włoskiego w Polsce.</p>
        <p>W Polsce naprawdę się zakochałam: po stażu na Uniwersytecie Jagiellońskim w Krakowie zdecydowałam się mieszkać tam przez siedem lat, budując tam swoje doświadczenie w nauczaniu, ze szczególną uwagą poświęconą osobom polskiego lub słowiańskiego pochodzenia.</p>
        <p>Przez sześć lat pracowałam we Włoskim Instytucie Kultury w Krakowie, doskonaląc się na tematycznych warsztatach i rozwijając swoje umiejętności w nauczaniu online.</p>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  .hero-ads { padding: 60px 0 40px; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 46px; align-items: center; }
  .hero-grid h1 { font-size: clamp(2rem, 3.6vw, 2.8rem); margin: 14px 0 6px; line-height: 1.12; }
  .stagione { font-weight: 600; color: var(--green); margin: 0 0 18px; font-size: 1.05rem; }
  .lede { color: var(--ink-soft); margin-bottom: 14px; }
  .main-photo { height: 380px; border-radius: 4px 90px 4px 4px; }
  .stamp.small { font-size: 0.78rem; padding: 4px 10px 3px; }

  .corsi-section { padding: 60px 0; }
  .intro { color: var(--ink-soft); max-width: 70ch; margin: 14px auto 0; text-align: center; }
  .price-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 44px; }
  .price-card { background: #fff; border: 1px solid var(--card-line); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; }
  .price-head { background: var(--red); color: #fff; text-align: center; font-weight: 600; font-size: 0.88rem; padding: 12px 10px; }
  .price-tag { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px 0; }
  .price-tag .livello { font-weight: 700; color: var(--green); font-size: 0.9rem; }
  .path-name { margin: 8px 16px 0; font-size: 0.82rem; color: var(--ink-soft); font-weight: 600; }
  .price-card .posti-badge { margin: 8px 16px 0; }
  .price-amount { padding: 6px 16px 12px; font-family: var(--font-display); }
  .price-amount .currency { font-size: 0.85rem; color: var(--ink-soft); margin-right: 6px; }
  .price-amount { font-size: 2.1rem; font-weight: 700; color: var(--red); }
  .price-card ul { list-style: none; margin: 0; padding: 14px 16px; border-top: 1px solid var(--card-line); flex-grow: 1; display: flex; flex-direction: column; gap: 10px; }
  .price-card li { font-size: 0.85rem; color: var(--ink-soft); padding-left: 14px; position: relative; }
  .price-card li::before { content: "•"; position: absolute; left: 0; color: var(--red); }
  .info-line { text-align: center; margin-top: 34px; color: var(--ink-soft); }
  .info-line a { color: var(--red); font-weight: 600; }

  .perche-section { padding: 20px 0 60px; }
  .perche-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .perche-item { border-top: 3px solid var(--green); padding-top: 14px; }
  .perche-item h3 { font-size: 1rem; margin-bottom: 8px; }
  .perche-item p { color: var(--ink-soft); font-size: 0.88rem; margin: 0; }

  .storia-section {
    background: var(--red); color: #fff;
    display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; align-items: center;
    padding: 60px 6vw; margin: 0;
  }
  .storia-photo { border-radius: 6px; overflow: hidden; aspect-ratio: 4 / 3; }
  .storia-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .storia-content h2 { color: #fff; font-size: clamp(1.3rem,2.2vw,1.7rem); margin: 8px 0 16px; }
  .storia-content p { color: #F5E4DC; font-size: 0.95rem; margin-bottom: 14px; }

  @media (max-width: 980px) {
    .price-grid, .perche-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .main-photo { order: -1; height: 280px; }
    .price-grid, .perche-grid { grid-template-columns: 1fr; }
    .storia-section { grid-template-columns: 1fr; padding: 40px 24px; }
  }
</style>
