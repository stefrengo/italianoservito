---
import MainLayout from '../../layouts/MainLayout.astro';
import { TURNSTILE_SITE_KEY } from '../../lib/turnstile.js';
// Versione polacca di /contatti — stesso form/endpoint dell'italiano
// (POST a /api/iscrizione), stessa struttura. "fonte" ha un suffisso -pl
// per riconoscere la provenienza del lead su Supabase/nelle notifiche.
// La lingua della mail di conferma e il redirect a /grazie?lang=pl sono
// già gestiti automaticamente da /api/iscrizione (rileva il Referer).
---

<MainLayout
  locale="pl"
  title="Kontakt | Zarezerwuj spotkanie zapoznawcze | L'Italiano è Servito"
  description="Napisz do Giady Longo: opowiedz jej, od czego zaczynasz, a razem znajdziecie odpowiedni kurs włoskiego dla Ciebie."
>
  <section class="apertura">
    <div class="wrap narrow" style="text-align:center;">
      <span class="eyebrow">Kontakt</span>
      <h1>Nie potrzebujesz perfekcji. Wystarczy pierwszy krok.</h1>
      <p class="lede">Opowiedz mi, od czego zaczynasz, a razem znajdziemy odpowiednią dla Ciebie ścieżkę.</p>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <form class="contact-form" method="POST" action="/api/iscrizione">
        <input type="hidden" name="fonte" value="contatti-pl" />
        <!-- Campo trappola anti-spam: vedi contatti.astro (versione italiana) per la spiegazione. -->
        <div class="hp-field" aria-hidden="true">
          <label for="sito-web-hp">Nie wypełniaj tego pola</label>
          <input type="text" id="sito-web-hp" name="sito_web" tabindex="-1" autocomplete="off" />
        </div>
        <label>
          Imię
          <input type="text" name="nome" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Telefon (także WhatsApp)
          <input type="tel" name="telefono" placeholder="Np. +48 123 456 789" required />
        </label>
        <label>
          Obecny poziom
          <select name="livello">
            <option>Zaczynam od zera</option>
            <option>Rozumiem, ale nie mówię</option>
            <option>Chcę się doskonalić</option>
          </select>
        </label>
        <label>
          Twój cel
          <textarea name="obiettivo" rows="4" placeholder="Np. podróżować po Włoszech, mówić pewniej, odkrywać kulturę..."></textarea>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="privacy" required />
          <span>Przeczytałam/em i akceptuję <a href="/privacy">Politykę Prywatności</a> *</span>
        </label>
        <!-- Turnstile: vedi SignupForm.astro (versione italiana) per la spiegazione completa. -->
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>
        <button type="submit" class="btn">Zarezerwuj spotkanie zapoznawcze</button>
      </form>
    </div>
  </section>
</MainLayout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

<style>
  .apertura { padding: 70px 0 20px; }
  .narrow { max-width: 620px; margin: 0 auto; }
  .lede { color: var(--ink-soft); margin-top: 12px; }
  .contact-form { display: flex; flex-direction: column; gap: 18px; margin-top: 20px; }
  .hp-field { position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .contact-form label { display: flex; flex-direction: column; gap: 6px; font-size: 0.92rem; font-weight: 500; color: var(--ink-soft); }
  .contact-form input, .contact-form select, .contact-form textarea {
    font-family: var(--font-body), sans-serif; font-size: 1rem; color: var(--ink);
    border: 1.5px solid var(--card-line); border-radius: 12px; padding: 12px 14px;
    background: #fff;
  }
  .contact-form label.checkbox { flex-direction: row; align-items: flex-start; gap: 10px; font-size: 0.85rem; }
  .contact-form label.checkbox input { margin-top: 3px; width: auto; }
  .contact-form label.checkbox a { color: var(--red); font-weight: 600; }
  .contact-form button { align-self: flex-start; margin-top: 8px; }
</style>
