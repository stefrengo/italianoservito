# Copia questo file in ".env" e riempi i valori veri.
# ".env" non va MAI caricato su GitHub (è già escluso da .gitignore).

# Da Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Queste due invece vanno impostate SOLO nel pannello Cloudflare del Worker
# (Settings → Variables and Secrets), non nel file .env locale:
# SUPABASE_SERVICE_ROLE_KEY
# RESEND_API_KEY
# GIADA_NOTIFICATION_EMAIL
