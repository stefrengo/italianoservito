{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "italianoservito",
  "main": "./dist/_worker.js/index.js",
  // Le variabili d'ambiente/secret (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
  // RESEND_API_KEY, GIADA_NOTIFICATION_EMAIL) restano impostate SOLO nel
  // pannello Cloudflare del Worker (Settings → Variables and Secrets), MAI
  // qui nel repo. Senza "keep_vars", ogni "wrangler deploy" le cancellerebbe:
  // https://developers.cloudflare.com/workers/wrangler/configuration/#source-of-truth
  "keep_vars": true,
  // Aggiornare a una data più recente solo se si verificano nuove funzionalità Workers da adottare
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
