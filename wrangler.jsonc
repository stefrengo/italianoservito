{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "italianoservito",
  "main": "./dist/_worker.js/index.js",
  // Aggiornare a una data più recente solo se si verificano nuove funzionalità Workers da adottare
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
